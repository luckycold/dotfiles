#!/usr/bin/env bash
# Launch Steam at the monitor scale of its window, or the focused monitor.
# Scale the actual CEF process, and verify it after Steam updates itself.
# --sync repairs a missing flag or a changed monitor scale. Games are left alone.
set -euo pipefail

scale_file="${XDG_RUNTIME_DIR:-/tmp}/steam-ui-scale"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/steam-launch.lock"

is_number() {
  [[ ${1:-} =~ ^[0-9]+([.][0-9]+)?$ ]]
}

focused_scale() {
  hyprctl monitors -j 2>/dev/null | jq -er '.[] | select(.focused == true) | .scale'
}

steam_window_scale() {
  local monitors clients
  monitors="$(hyprctl monitors -j 2>/dev/null)" || return 1
  clients="$(hyprctl clients -j 2>/dev/null)" || return 1
  jq -en --argjson monitors "$monitors" --argjson clients "$clients" '
    [$clients[] | select(.class == "steam")] as $wins
    | ($wins | map(select(.title == "Steam")) | .[0] // $wins[0] // null) as $win
    | if $win == null then empty
      else ($monitors[] | select(.id == $win.monitor) | .scale)
      end
  '
}

games_running() {
  hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class | test("^steam_app"))' >/dev/null
}

steam_running() {
  hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "steam")' >/dev/null
}

resolve_scale() {
  local scale
  scale="$(steam_window_scale 2>/dev/null || true)"
  if ! is_number "$scale"; then
    scale="$(focused_scale 2>/dev/null || true)"
  fi
  if ! is_number "$scale"; then
    scale=1
  fi
  # Match the compositor, not a guessed physical DPI.
  local bias="${STEAM_UI_SCALE_BIAS:-1}"
  if ! is_number "$bias"; then
    bias=1
  fi
  awk -v scale="$scale" -v bias="$bias" 'BEGIN { printf "%g\n", scale * bias }'
}

# Keep the wrapper stock during update verification. Only patch once the
# browser parent is running, then restart that parent to apply the CEF scale.
steam_wrap_path() {
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/Steam/ubuntu12_64/steamwebhelper_sniper_wrap.sh"
}

ensure_webhelper_device_scale() {
  local scale="$1"
  local wrap
  wrap="$(steam_wrap_path)"
  if [[ ! -f $wrap ]]; then
    return 0
  fi
  python3 - "$wrap" "$scale" <<'PY'
import re, sys

path, scale = sys.argv[1], sys.argv[2]
text = open(path, encoding="utf-8", errors="replace").read()
flag = f" --force-device-scale-factor={scale}" if scale else ""
updated = re.sub(
    r"(?m)^(exec \./steamwebhelper)(?: --force-device-scale-factor=[0-9.]+)?( \"\$@\")",
    rf"\1{flag}\2",
    text,
    count=1,
)
if updated != text:
    open(path, "w", encoding="utf-8").write(updated)
PY
}

# Only the browser parent has argv[0] == ./steamwebhelper. Substring matches
# also select the container launcher and can tear down Steam's whole runtime.
webhelper_pids() {
  local cmd argv0
  for cmd in /proc/[0-9]*/cmdline; do
    [[ -O $cmd && -r $cmd ]] || continue
    IFS= read -r -d '' argv0 <"$cmd" 2>/dev/null || continue
    [[ $argv0 == ./steamwebhelper ]] || continue
    cmd="${cmd#/proc/}"
    printf '%s\n' "${cmd%/cmdline}"
  done
}

webhelper_has_scale() {
  local pid
  while read -r pid; do
    if grep -Fxqz -- "--force-device-scale-factor=$1" "/proc/$pid/cmdline" 2>/dev/null; then
      return 0
    fi
  done < <(webhelper_pids)
  return 1
}

guard_webhelper_device_scale() {
  local scale="$1" workspace="${2:-}" monitor="${3:-}" i pid address
  # Updates can take far longer than the old 12-second guard. Keep this
  # bounded and repair only the browser parent, never bwrap or its wrapper.
  for ((i = 0; i < 180; i++)); do
    if [[ -z $workspace ]] && steam_running; then
      scale="$(resolve_scale)"
    fi
    if [[ -n $(webhelper_pids) ]]; then
      ensure_webhelper_device_scale "$scale"
    fi
    if webhelper_has_scale "$scale"; then
      address="$(hyprctl clients -j 2>/dev/null | jq -r '[.[] | select(.class == "steam" and .title == "Steam")][0].address // empty')"
      if [[ -n $address ]]; then
        if [[ -n $workspace ]]; then
          hyprctl eval "hl.dispatch(hl.dsp.window.move({workspace=$workspace, window=\"address:$address\", follow=false}))" >/dev/null
          # An empty workspace disappears while CEF restarts. Recreating it
          # on the focused monitor would undo a move to a different scale.
          if [[ -n $monitor ]]; then
            hyprctl eval "hl.dispatch(hl.dsp.workspace.move({workspace=$workspace, monitor=$monitor}))" >/dev/null
          fi
        fi
        printf '%s\n' "$scale" >"$scale_file"
        return 0
      fi
    else
      if games_running; then
        return 0
      fi
      while read -r pid; do
        kill "$pid" 2>/dev/null || true
      done < <(webhelper_pids)
    fi
    sleep 1
  done
  printf 'Steam CEF scale could not be verified within 180 seconds\n' >&2
  return 1
}

exec_steam() {
  local scale="$1"
  shift
  if ! pgrep -u "$UID" -x steam >/dev/null; then
    ensure_webhelper_device_scale ""
  fi
  (
    exec 9>"$lock_file"
    flock 9
    guard_webhelper_device_scale "$scale"
  ) &
  # The long-lived Steam process must not inherit the guard lock.
  exec 9>&-
  local cmd=(env -u GDK_SCALE -u GDK_DPI_SCALE -u STEAM_FORCE_DESKTOPUI_SCALING)
  if [[ -z ${LD_PRELOAD:-} && -e /usr/lib32/libextest.so ]]; then
    cmd+=(LD_PRELOAD=/usr/lib32/libextest.so)
  fi
  exec "${cmd[@]}" /usr/bin/steam "$@"
}

sync_scale() {
  exec 9>"$lock_file"
  if ! flock -n 9; then
    return 0
  fi

  if ! steam_running; then
    return 0
  fi

  local desired restore_workspace restore_monitor
  desired="$(resolve_scale)"
  if webhelper_has_scale "$desired"; then
    return 0
  fi
  if games_running; then
    return 0
  fi

  restore_workspace="$(hyprctl clients -j | jq -r '[.[] | select(.class == "steam" and .title == "Steam")][0].workspace.id // empty')"
  restore_monitor="$(hyprctl clients -j | jq -r '[.[] | select(.class == "steam" and .title == "Steam")][0].monitor // empty')"
  guard_webhelper_device_scale "$desired" "$restore_workspace" "$restore_monitor"
}

if [[ ${1:-} == --sync ]]; then
  sync_scale
  exit 0
fi

exec_steam "$(resolve_scale)" "$@"
