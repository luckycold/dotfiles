#!/usr/bin/env bash
# Launch Steam without global GTK scale overrides.
# The CEF scale restarter was withdrawn on 2026-10-26: sending SIGTERM to
# ./steamwebhelper hit pre-exec children and CEF aborted (g_pipe_pid SIGTRAP).
# Use Steam's own Accessibility > UI Scale slider instead.
set -euo pipefail

# Kept so hypr/steam.lua or old bindings that still call --sync are harmless.
if [[ ${1:-} == --sync ]]; then
  exit 0
fi

cmd=(env -u GDK_SCALE -u GDK_DPI_SCALE -u STEAM_FORCE_DESKTOPUI_SCALING)
if [[ -z ${LD_PRELOAD:-} && -e /usr/lib32/libextest.so ]]; then
  cmd+=(LD_PRELOAD=/usr/lib32/libextest.so)
fi
exec "${cmd[@]}" /usr/bin/steam "$@"
