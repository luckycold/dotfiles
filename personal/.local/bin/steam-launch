#!/usr/bin/env bash
# Launch Steam at the monitor scale of its window, or the focused monitor.
# Steam is XWayland and only reads UI scale at start, so --sync restarts the
# client when Hyprland reports a different monitor scale. Games are left alone.
set -euo pipefail

scale_file="${XDG_RUNTIME_DIR:-/tmp}/steam-ui-scale"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/steam-launch.lock"

is_number() {
  [[ ${1:-} =~ ^[0-9]+([.][0-9]+)?$ ]]
}

focused_scale() {
  hyprctl monitors -j 2>/dev/null | jq -er '.[] | select(.focused == true) | .scale'
}

steam_window_scale() {
  local monitors clients
  monitors="$(hyprctl monitors -j 2>/dev/null)" || return 1
  clients="$(hyprctl clients -j 2>/dev/null)" || return 1
  jq -en --argjson monitors "$monitors" --argjson clients "$clients" '
    [$clients[] | select(.class == "steam")] as $wins
    | ($wins | map(select(.title == "Steam")) | .[0] // $wins[0] // null) as $win
    | if $win == null then empty
      else ($monitors[] | select(.id == $win.monitor) | .scale)
      end
  '
}

games_running() {
  hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class | test("^steam_app"))' >/dev/null
}

steam_running() {
  hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "steam")' >/dev/null
}

applied_scale() {
  if [[ -r $scale_file ]]; then
    cat "$scale_file"
  fi
}

write_scale() {
  printf '%s\n' "$1" >"$scale_file"
}

resolve_scale() {
  local scale
  scale="$(steam_window_scale 2>/dev/null || true)"
  if ! is_number "$scale"; then
    scale="$(focused_scale 2>/dev/null || true)"
  fi
  if ! is_number "$scale"; then
    scale=1
  fi
  # Hyprland 2x on this 2880x1920 panel is below the physical ~2.7x. A 2x
  # Steam UI looked too big in Omarchy's 1100x700 box and too small once
  # the window used the monitor. Bias toward the panel density.
  local bias="${STEAM_UI_SCALE_BIAS:-1.25}"
  if ! is_number "$bias"; then
    bias=1.25
  fi
  awk -v scale="$scale" -v bias="$bias" 'BEGIN { printf "%g\n", scale * bias }'
}

wait_for_steam_exit() {
  local i
  for i in $(seq 1 25); do
    if steam_running; then
      sleep 0.2
    else
      return 0
    fi
  done
  return 1
}

exec_steam() {
  local scale="$1"
  shift
  write_scale "$scale"

  local cmd=(env -u GDK_SCALE -u GDK_DPI_SCALE STEAM_FORCE_DESKTOPUI_SCALING="$scale")
  if [[ -z ${LD_PRELOAD:-} && -e /usr/lib32/libextest.so ]]; then
    cmd+=(LD_PRELOAD=/usr/lib32/libextest.so)
  fi
  exec "${cmd[@]}" /usr/bin/steam -forcedesktopscaling "$scale" "$@"
}

sync_scale() {
  exec 9>"$lock_file"
  if ! flock -n 9; then
    return 0
  fi

  if ! steam_running; then
    return 0
  fi

  local desired applied
  desired="$(resolve_scale)"
  applied="$(applied_scale || true)"
  if [[ -z $applied ]]; then
    write_scale "$desired"
    return 0
  fi
  if [[ $desired == "$applied" ]]; then
    return 0
  fi
  if games_running; then
    return 0
  fi

  steam -shutdown >/dev/null 2>&1 || true
  wait_for_steam_exit || true
  exec_steam "$desired"
}

if [[ ${1:-} == --sync ]]; then
  sync_scale
  exit 0
fi

exec_steam "$(resolve_scale)" "$@"
