#!/usr/bin/env bash
# Point wluma's laptop curve at the active hyprmoncfg profile.
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/wluma"
active="$state_dir/eDP-1.yaml"
active_curve="$state_dir/eDP-1.active-curve"

status="$(hyprmoncfg status 2>/dev/null)"
profile="$(awk -F': ' '/^Active profile:/{print $2; exit}' <<<"$status")"
if [[ $profile == "custom layout" ]]; then
  profile="$(awk -F': ' '/^Recommended profile:/{print $2; exit}' <<<"$status")"
fi
case "$profile" in
  Docked) curve=docked ;;
  "Stand alone") curve=standalone ;;
  *) exit 0 ;;
esac

target="$state_dir/eDP-1.$curve.yaml"
mkdir -p "$state_dir"

previous=""
if [[ -L $active ]]; then
  previous="$(readlink "$active")"
  previous="${previous#eDP-1.}"
  previous="${previous%.yaml}"
elif [[ -f $active_curve ]]; then
  previous="$(cat "$active_curve")"
fi

if [[ -f $active && $previous == "$curve" ]]; then
  printf '%s\n' "$curve" >"$active_curve"
  exit 0
fi

max_brightness=""
if [[ $curve == docked && ! -e $target ]]; then
  max_brightness="$(brightnessctl --class=backlight max)"
fi

systemctl --user stop wluma.service
trap 'systemctl --user start wluma.service' EXIT

# wluma saves by renaming a new file over eDP-1.yaml, replacing its symlink.
# Keep the previous profile's learned curve before selecting the next one.
if [[ -f $active && ! -L $active ]]; then
  case "$previous" in
    docked|standalone) mv -f "$active" "$state_dir/eDP-1.$previous.yaml" ;;
    *) mv -f "$active" "$target" ;;
  esac
fi

if [[ ! -e $target ]]; then
  if [[ $curve == docked ]]; then
    cat >"$target" <<EOF
output_name: eDP-1
entries:
  brightness:
  - als: 100000
    luma: 0
    value: $max_brightness
  dim: []
  temperature: []
EOF
  else
    cat >"$target" <<'EOF'
output_name: eDP-1
entries:
  brightness: []
  dim: []
  temperature: []
EOF
  fi
fi

ln -sfn "eDP-1.$curve.yaml" "$active"
printf '%s\n' "$curve" >"$active_curve"
