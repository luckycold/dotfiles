{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/renovate-image$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "renovate/renovate",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^common/\\.config/opencode/config\\.json$/"
      ],
      "matchStrings": [
        "\\\"opencode-openai-codex-auth@(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "numman-ali/opencode-openai-codex-auth",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^common/\\.config/opencode/config\\.json$/"
      ],
      "matchStrings": [
        "\\\"opencode-gemini-auth@(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jenslys/opencode-gemini-auth",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^common/\\.bashrc\\.d/dotfiles_management\\.bash$/"
      ],
      "matchStrings": [
        "_AGENT_SKILLS_CLI_PIN=(?<currentValue>\\S+) # renovate: datasource=npm depName=skills"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "skills",
      "versioningTemplate": "semver"
    }
  ]
}
