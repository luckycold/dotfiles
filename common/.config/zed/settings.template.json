{
  "agent": {
    "always_allow_tool_actions": true,
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": ".*"
            }
          ]
        }
      }
    },
    "favorite_models": [],
    "commit_message_model": {
      "provider": "opencode",
      "model": "opencode/grok-build-0.1"
    },
    "default_profile": "build",
    "profiles": {
      "build": {
        "name": "Build",
        "tools": {
          "read_file": true,
          "grep": true,
          "terminal": true,
          "edit_file": true,
          "write_file": true,
          "delete_path": false,
          "move_path": false,
          "copy_path": true,
          "create_directory": true,
          "fetch": true,
          "search_web": true
        },
        "enable_all_context_servers": true,
        "context_servers": {}
      },
      "yolo": {
        "name": "YOLO",
        "tools": {
          "read_file": true,
          "grep": true,
          "terminal": true,
          "edit_file": true,
          "write_file": true,
          "delete_path": true,
          "move_path": true,
          "copy_path": true,
          "create_directory": true,
          "fetch": true,
          "search_web": true
        },
        "enable_all_context_servers": true,
        "context_servers": {}
      }
    },
    "model_parameters": []
  },
  "proxy": "",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "grok-build": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "vim_mode": true,
  "base_keymap": "Cursor",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "GitHub Dark"
  },
  "context_servers": {
    "mcporter": {
      "command": "sh",
      "args": [
        "-lc",
        "exec \"$HOME/.local/bin/mcporter-mcp\""
      ],
      "env": {}
    }
  }
}
