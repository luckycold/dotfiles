{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 32000,
    "prune": true,
    "reserved": 24000,
    "tail_turns": 4
  },
  "mcp": {
    "mcporter": {
      "command": [
        "sh",
        "-lc",
        "exec \"$HOME/.local/bin/mcporter-mcp\""
      ],
      "enabled": true,
      "type": "local"
    }
  }
}
