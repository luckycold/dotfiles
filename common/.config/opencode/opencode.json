{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 32000,
    "prune": true,
    "reserved": 24000,
    "tail_turns": 4
  },
  "mcp": {
    "kagi-ken": {
      "command": [
        "npx",
        "-y",
        "czottmann/kagi-ken-mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "linear": {
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/linear}"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "mem0": {
      "headers": {
        "Authorization": "Token {file:~/.config/opencode/mem0-token}"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://mcp.mem0.ai/mcp/"
    }
  }
}
