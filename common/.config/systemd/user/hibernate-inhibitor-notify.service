[Unit]
Description=Notify when hibernation is blocked by a sleep inhibitor
Documentation=man:systemd-inhibit(1)

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/hibernate-inhibitor-notify
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
