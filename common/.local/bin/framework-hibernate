#!/bin/bash

set -euo pipefail

readonly state_dir=${XDG_RUNTIME_DIR:-/tmp}/framework-hibernate
readonly user_units=(
  app-pcloud@autostart.service
  app-bitwarden@autostart.service
)

notify() {
  local message=$1

  logger -t framework-hibernate "${message}"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Hibernate" "${message}" >/dev/null 2>&1 || true
  fi
}

can_hibernate() {
  [[ $(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager CanHibernate 2>/dev/null) == 's "yes"' ]]
}

stop_user_units() {
  local unit unit_slug marker

  mkdir -p "${state_dir}"

  for unit in "${user_units[@]}"; do
    if systemctl --user is-active --quiet "${unit}"; then
      unit_slug=${unit//[^[:alnum:]_.-]/_}
      marker="${state_dir}/${unit_slug}.active"
      : > "${marker}"
      systemctl --user stop "${unit}" || notify "Failed to stop ${unit}"
    fi
  done
}

start_user_units() {
  local marker unit unit_slug candidate

  shopt -s nullglob
  for marker in "${state_dir}"/*.active; do
    unit_slug=$(basename "${marker}")
    unit_slug=${unit_slug%.active}

    unit=""
    for candidate in "${user_units[@]}"; do
      if [[ ${candidate//[^[:alnum:]_.-]/_} == "${unit_slug}" ]]; then
        unit=${candidate}
        break
      fi
    done

    if [[ -n ${unit} ]]; then
      systemctl --user start "${unit}" || notify "Failed to restart ${unit}"
    fi

    rm -f "${marker}"
  done

  rmdir "${state_dir}" 2>/dev/null || true
}

wait_for_hibernate() {
  local _

  for _ in {1..20}; do
    can_hibernate && return 0
    sleep 0.25
  done

  return 1
}

main() {
  stop_user_units

  if ! wait_for_hibernate; then
    notify "Hibernate is still unavailable after stopping user app blockers."
    start_user_units
    return 1
  fi

  if ! systemctl hibernate; then
    notify "systemctl hibernate failed."
    start_user_units
    return 1
  fi

  start_user_units
}

main "$@"
