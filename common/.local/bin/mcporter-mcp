#!/usr/bin/env sh
set -eu

config="${MCPORTER_CONFIG:-$HOME/.mcporter/mcporter.json}"
servers="${MCPORTER_SERVERS:-kagi-ken,context7,gh_grep,gitlab,mem0}"

if ! command -v mcporter >/dev/null 2>&1; then
  printf '%s\n' 'mcporter-mcp: mcporter is not installed; see the dotfiles README' >&2
  exit 127
fi

if [ ! -f "$config" ]; then
  printf '%s\n' "mcporter-mcp: $config is not rendered; run init-env-secrets (scoped agents: their authorized selector)" >&2
  exit 78
fi

exec mcporter --config "$config" serve --stdio --servers "$servers"
