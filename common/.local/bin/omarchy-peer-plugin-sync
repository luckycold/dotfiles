#!/usr/bin/env bash
# Bidirectional sync of Omarchy third-party plugin checkouts with a mounted
# peer OS home. Prefers Unison when installed; otherwise two-way rsync --update.
# Does not touch shell.json or plugin sidecar secrets.
set -euo pipefail

local_dir=$(readlink -f "$HOME/.config/omarchy/plugins")
[[ -d $local_dir ]] || exit 0

stamp_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
mkdir -p "$stamp_dir"
stamp="$stamp_dir/peer-plugin-sync.stamp"
now=$(date +%s)
if [[ -f $stamp ]]; then
  then_ts=$(stat -c %Y "$stamp" 2>/dev/null || echo 0)
  if (( now - then_ts < 3 )); then
    exit 0
  fi
fi
touch "$stamp"

sync_pair() {
  local src=$1 dest=$2
  if command -v unison >/dev/null; then
    unison "$src" "$dest" -ui text -batch -auto -ignore 'Name .add.tmp.*'
    return
  fi
  rsync -a --update --exclude='.add.tmp.*' "$src/" "$dest/"
  rsync -a --update --exclude='.add.tmp.*' "$dest/" "$src/"
}

shopt -s nullglob
status=0
found=0
for candidate in /run/media/"$USER"/*/@home/"$USER"/.config/omarchy/plugins; do
  [[ -d $candidate ]] || continue
  peer_dir=$(readlink -f "$candidate")
  [[ $peer_dir != "$local_dir" ]] || continue
  found=1
  if ! sync_pair "$local_dir" "$peer_dir"; then
    echo "omarchy-peer-plugin-sync: sync failed for $peer_dir" >&2
    status=1
  fi
done

(( found == 0 )) && exit 0
exit "$status"
