#!/usr/bin/python3
# omarchy:summary=Print the Grok usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Grok Build usage into one display-ready JSON record.

Limits come from the Grok CLI billing endpoint. Local token stats come from
~/.grok/logs/unified.jsonl. The agents panel only reads the JSON this prints.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "grok"
AGENT_NAME = "Grok"
AUTH_HELP = "Run `grok login` to restore authoritative usage."
BILLING_URL = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"
REFRESH_URL = "https://auth.x.ai/oauth2/token"
PROBE_MIN_INTERVAL_SECONDS = 15
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900


def grok_home() -> Path:
  return Path(os.environ.get("GROK_HOME") or (Path.home() / ".grok")).expanduser()


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def cache_path() -> Path:
  return cache_root() / "grok.json"


def now_utc() -> dt.datetime:
  return dt.datetime.now(dt.timezone.utc)


def iso(value: dt.datetime) -> str:
  return value.astimezone(dt.timezone.utc).isoformat()


def number(value: Any) -> int:
  try:
    return max(0, int(float(value or 0)))
  except (TypeError, ValueError):
    return 0


def empty_stats() -> dict[str, Any]:
  today = dt.datetime.now().astimezone().date()
  recent = [{"date": (today - dt.timedelta(days=offset)).isoformat(), "messageCount": 0} for offset in range(6, -1, -1)]
  return {
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": recent,
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "modelUsage": {},
  }


def base_record(**overrides: Any) -> dict[str, Any]:
  record: dict[str, Any] = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": iso(now_utc()),
    "ready": False,
    "hasLocalStats": False,
    "hasPromptStats": True,
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": "",
    "limits": [],
  }
  record.update(empty_stats())
  record.update(overrides)
  return record


def load_auth() -> dict[str, Any] | None:
  path = grok_home() / "auth.json"
  try:
    data = json.loads(path.read_text())
  except (OSError, json.JSONDecodeError):
    return None
  if not isinstance(data, dict):
    return None
  for value in data.values():
    if isinstance(value, dict) and (value.get("key") or value.get("refresh_token")):
      return value
  return None


def save_auth(entry: dict[str, Any]) -> None:
  path = grok_home() / "auth.json"
  try:
    data = json.loads(path.read_text())
  except (OSError, json.JSONDecodeError):
    return
  if not isinstance(data, dict):
    return
  for key, value in data.items():
    if isinstance(value, dict) and value.get("user_id") == entry.get("user_id"):
      data[key] = entry
      path.write_text(json.dumps(data, indent=2) + "\n")
      return


def refresh_key(entry: dict[str, Any]) -> str:
  refresh_token = str(entry.get("refresh_token") or "")
  client_id = str(entry.get("oidc_client_id") or "")
  if not refresh_token or not client_id:
    return str(entry.get("key") or "")
  body = urllib.parse.urlencode({
    "grant_type": "refresh_token",
    "refresh_token": refresh_token,
    "client_id": client_id,
  }).encode()
  req = urllib.request.Request(REFRESH_URL, data=body, method="POST")
  req.add_header("Content-Type", "application/x-www-form-urlencoded")
  with urllib.request.urlopen(req, timeout=15) as response:
    payload = json.loads(response.read())
  token = str(payload.get("access_token") or payload.get("key") or "")
  if token:
    entry["key"] = token
    if payload.get("refresh_token"):
      entry["refresh_token"] = payload["refresh_token"]
    save_auth(entry)
  return token or str(entry.get("key") or "")


def request_json(url: str, token: str) -> dict[str, Any]:
  req = urllib.request.Request(url, headers={
    "Authorization": f"Bearer {token}",
    "Accept": "application/json",
    "User-Agent": "omarchy-agent-usage-grok",
  })
  with urllib.request.urlopen(req, timeout=15) as response:
    payload = json.loads(response.read())
  return payload if isinstance(payload, dict) else {}


def billing_limits(payload: dict[str, Any]) -> tuple[list[dict[str, Any]], str]:
  config = payload.get("config") if isinstance(payload.get("config"), dict) else payload
  percent = float(config.get("creditUsagePercent") or 0) / 100.0
  period = config.get("currentPeriod") if isinstance(config.get("currentPeriod"), dict) else {}
  end = str(period.get("end") or config.get("billingPeriodEnd") or "")
  limits = [{
    "label": "Weekly",
    "title": "Weekly",
    "percent": max(0.0, min(1.0, percent)),
    "resetsAt": end,
  }]
  return limits, "X Premium+" if percent or end else ""


def scan_logs() -> dict[str, Any]:
  stats = empty_stats()
  log_path = grok_home() / "logs" / "unified.jsonl"
  if not log_path.is_file():
    return stats

  today = dt.datetime.now().astimezone().date()
  recent_dates = [(today - dt.timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]
  recent = {day: 0 for day in recent_dates}
  today_by_model: dict[str, int] = {}
  model_usage: dict[str, dict[str, int]] = {}
  active_dates: set[str] = set()
  prompts = 0
  sessions: set[str] = set()
  today_prompts = 0
  today_sessions: set[str] = set()
  today_total = 0
  model = "grok"

  with log_path.open(errors="replace") as handle:
    for line in handle:
      try:
        event = json.loads(line)
      except json.JSONDecodeError:
        continue
      ctx = event.get("ctx") if isinstance(event.get("ctx"), dict) else {}
      if event.get("msg") == "model changed" and ctx.get("model"):
        model = str(ctx["model"])
        continue
      if event.get("msg") != "shell.turn.inference_done":
        continue
      raw_ts = str(event.get("ts") or "")
      try:
        parsed = dt.datetime.fromisoformat(raw_ts.replace("Z", "+00:00")).astimezone()
        day = parsed.date().isoformat()
      except ValueError:
        day = today.isoformat()
      prompt_tokens = number(ctx.get("prompt_tokens"))
      cached = number(ctx.get("cached_prompt_tokens"))
      completion = number(ctx.get("completion_tokens"))
      total = prompt_tokens + cached + completion
      if total <= 0:
        continue
      prompts += 1
      session_key = str(ctx.get("loop_index") or raw_ts)
      sessions.add(day)
      active_dates.add(day)
      bucket = model_usage.setdefault(model, {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
      })
      bucket["inputTokens"] += prompt_tokens
      bucket["outputTokens"] += completion
      bucket["cacheReadInputTokens"] += cached
      if day in recent:
        recent[day] += total
      if day == today.isoformat():
        today_prompts += 1
        today_sessions.add(session_key)
        today_total += total
        today_by_model[model] = today_by_model.get(model, 0) + total

  stats.update({
    "hasLocalStats": prompts > 0,
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_total,
    "todayTokensByModel": today_by_model,
    "recentDays": [{"date": day, "messageCount": recent[day]} for day in recent_dates],
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(active_dates),
    "activeDates": sorted(active_dates),
    "modelUsage": model_usage,
  })
  return stats


def load_cache() -> dict[str, Any] | None:
  try:
    return json.loads(cache_path().read_text())
  except (OSError, json.JSONDecodeError):
    return None


def save_cache(record: dict[str, Any]) -> None:
  path = cache_path()
  tmp = tempfile.NamedTemporaryFile("w", delete=False, dir=path.parent, prefix=".grok.")
  json.dump(record, tmp)
  tmp.close()
  os.replace(tmp.name, path)


def scan(force: bool, limits_only: bool) -> dict[str, Any]:
  cached = load_cache()
  if cached and not force:
    try:
      age = (now_utc() - dt.datetime.fromisoformat(cached["updatedAt"])).total_seconds()
    except Exception:
      age = 10**9
    reuse = LIMITS_ONLY_REUSE_SECONDS if limits_only else SCAN_REUSE_SECONDS
    if age < reuse:
      return cached

  record = base_record()
  stats = cached if limits_only and cached else scan_logs()
  record.update({k: stats[k] for k in empty_stats()})
  record["hasLocalStats"] = bool(stats.get("hasLocalStats"))
  record["hasPromptStats"] = True

  auth = load_auth()
  if not auth:
    record["usageStatusText"] = "Grok unavailable"
    record["authHelpText"] = AUTH_HELP
    record["updatedAt"] = iso(now_utc())
    return record

  token = str(auth.get("key") or "")
  payload: dict[str, Any] = {}
  try:
    payload = request_json(BILLING_URL, token)
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      try:
        token = refresh_key(auth)
        payload = request_json(BILLING_URL, token)
      except Exception:
        record["usageStatusText"] = "Grok limits unavailable"
        record["authHelpText"] = AUTH_HELP
    else:
      record["usageStatusText"] = "Grok limits unavailable"
      record["authHelpText"] = AUTH_HELP
  except Exception:
    record["usageStatusText"] = "Grok limits unavailable"
    record["authHelpText"] = AUTH_HELP

  if payload:
    limits, tier = billing_limits(payload)
    record["limits"] = limits
    record["tierLabel"] = tier
    record["ready"] = True
    record["usageStatusText"] = ""
    record["authHelpText"] = ""
  elif record["hasLocalStats"]:
    record["ready"] = True

  record["updatedAt"] = iso(now_utc())
  save_cache(record)
  time.sleep(0)  # keep probe spacing obvious at call sites
  return record


def main() -> int:
  parser = argparse.ArgumentParser(description="Print the Grok usage record as JSON")
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()
  try:
    record = scan(args.force, args.limits_only)
  except Exception:
    record = base_record(usageStatusText="Grok unavailable", authHelpText=AUTH_HELP)
  print(json.dumps(record, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
