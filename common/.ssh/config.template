# Rendered to ~/.ssh/config by init-env-secrets.

Host nas
	HostName tr.{{pass://Main/SSH Config/note}}
	User root

Host pve
	HostName pve.{{pass://Main/SSH Config/note}}
	User lucky

# Hydra: key and per-env Vault certs come from `. hhlogin <env>` (local-env).
Host *.dev.netbird.internal
	CertificateFile ~/.ssh/id_ed25519-cert-dev.pub

Host *.stg.netbird.internal
	CertificateFile ~/.ssh/id_ed25519-cert-stg.pub

Host *.prod.netbird.internal
	CertificateFile ~/.ssh/id_ed25519-cert-prod.pub

Host *.netbird.internal
	User hydra-admin
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes

Host *
	IdentityAgent ~/.ssh/proton-pass-agent.sock
