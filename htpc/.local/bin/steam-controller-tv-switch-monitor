#!/usr/bin/env bash
set -euo pipefail

controller_pattern="${STEAM_CONTROLLER_PATTERN:-Steam Controller|Valve Software Steam Controller|Valve Steam Controller}"
controller_ignore_pattern="${STEAM_CONTROLLER_IGNORE_PATTERN:-}"
controller_hotplug_pattern="${STEAM_CONTROLLER_HOTPLUG_PATTERN:-$controller_pattern}"
debounce_seconds="${STEAM_CONTROLLER_TV_SWITCH_DEBOUNCE:-3}"
resume_delay_seconds="${STEAM_CONTROLLER_TV_SWITCH_RESUME_DELAY:-0}"
resume_cec_wake_delay="${STEAM_CONTROLLER_TV_SWITCH_RESUME_CEC_WAKE_DELAY:-1}"
cooldown_seconds="${STEAM_CONTROLLER_TV_SWITCH_COOLDOWN:-10}"
switch_on_startup="${STEAM_CONTROLLER_TV_SWITCH_ON_STARTUP:-1}"
switch_on_resume="${STEAM_CONTROLLER_TV_SWITCH_ON_RESUME:-1}"
ignore_initial_hotplug_seconds="${STEAM_CONTROLLER_TV_SWITCH_IGNORE_INITIAL_HOTPLUG_SECONDS:-0}"
ignore_resume_hotplug_seconds="${STEAM_CONTROLLER_TV_SWITCH_IGNORE_RESUME_HOTPLUG_SECONDS:-0}"
steam_resume_enable="${STEAM_CONTROLLER_TV_SWITCH_STEAM_RESUME_ENABLE:-0}"
steam_resume_delay_seconds="${STEAM_CONTROLLER_TV_SWITCH_STEAM_RESUME_DELAY:-5}"
steam_controller_log="${STEAM_CONTROLLER_TV_SWITCH_STEAM_CONTROLLER_LOG:-$HOME/.local/share/Steam/logs/controller_ui.txt}"
steam_controller_log_lines="${STEAM_CONTROLLER_TV_SWITCH_STEAM_CONTROLLER_LOG_LINES:-500}"
steam_primary_display_enable="${STEAM_CONTROLLER_TV_SWITCH_STEAM_PRIMARY_DISPLAY_ENABLE:-1}"
steam_primary_display_command="${STEAM_CONTROLLER_TV_SWITCH_STEAM_PRIMARY_DISPLAY_COMMAND:-$HOME/.local/bin/htpc-steam-primary-display}"
switch_to_tv_command="${SWITCH_TO_TV_COMMAND:-$HOME/.local/bin/switch-to-tv}"
lock_file="${STEAM_CONTROLLER_TV_SWITCH_LOCK:-${XDG_RUNTIME_DIR:-/tmp}/steam-controller-tv-switch.lock}"
last_run_file="${STEAM_CONTROLLER_TV_SWITCH_LAST_RUN:-${XDG_RUNTIME_DIR:-/tmp}/steam-controller-tv-switch.last-run}"
last_resume_file="${STEAM_CONTROLLER_TV_SWITCH_LAST_RESUME:-${XDG_RUNTIME_DIR:-/tmp}/steam-controller-tv-switch.last-resume}"
sleep_pending_file="${STEAM_CONTROLLER_TV_SWITCH_SLEEP_PENDING:-${XDG_RUNTIME_DIR:-/tmp}/steam-controller-tv-switch.sleep-pending}"
started_at="$(date +%s)"
child_pids=()

log() {
  printf 'steam-controller-tv-switch-monitor: %s\n' "$*"
}

die() {
  log "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

require_executable() {
  [[ -x "$1" ]] || die "missing required executable: $1"
}

steam_controller_present() {
  local name
  local name_file

  for name_file in /sys/class/input/event*/device/name; do
    [[ -r "$name_file" ]] || continue
    name="$(<"$name_file")"

    if [[ -n "$controller_ignore_pattern" && "$name" =~ $controller_ignore_pattern ]]; then
      continue
    fi

    if [[ "$name" =~ $controller_pattern ]]; then
      return 0
    fi
  done

  return 1
}

input_hotplug_is_controller() {
  local line="$1"
  local name=""
  local name_file
  local sys_path

  [[ "$line" =~ (/devices/[^[:space:]]+) ]] || return 1
  sys_path="/sys${BASH_REMATCH[1]}"

  for name_file in "$sys_path/device/name" "$sys_path/name"; do
    [[ -r "$name_file" ]] || continue
    name="$(<"$name_file")"
    break
  done

  [[ -n "$name" ]] || return 1

  if [[ -n "$controller_ignore_pattern" && "$name" =~ $controller_ignore_pattern ]]; then
    return 1
  fi

  [[ "$name" =~ $controller_hotplug_pattern ]]
}

run_switch_command() {
  local cec_wake_delay="${1:-}"

  if [[ -n "$cec_wake_delay" ]]; then
    flock -n "$lock_file" env HTPC_TV_CEC_WAKE_DELAY="$cec_wake_delay" "$switch_to_tv_command"
  else
    flock -n "$lock_file" "$switch_to_tv_command"
  fi

  sync_steam_primary_display
}

sync_steam_primary_display() {
  [[ "$steam_primary_display_enable" == "1" ]] || return 0
  [[ -x "$steam_primary_display_command" ]] || return 0

  if ! "$steam_primary_display_command"; then
    log "Steam primary display sync failed"
  fi
}

switch_if_present() {
  local cec_wake_delay="${1:-}"
  local force="${2:-0}"
  local trigger="${3:-event}"
  local last_run
  local now

  if steam_controller_present; then
    now="$(date +%s)"
    last_run="0"
    [[ -r "$last_run_file" ]] && last_run="$(<"$last_run_file")"

    if [[ "$force" != "1" ]] && (( now - last_run < cooldown_seconds )); then
      return 0
    fi

    log "Steam Controller detected via $trigger; switching to TV"
    printf '%s\n' "$now" >"$last_run_file"
    run_switch_command "$cec_wake_delay"
  fi
}

resume_hotplug_suppressed() {
  local last_resume
  local now

  (( ignore_resume_hotplug_seconds > 0 )) || return 1

  if [[ -e "$sleep_pending_file" ]]; then
    return 0
  fi

  [[ -r "$last_resume_file" ]] || return 1

  last_resume="$(<"$last_resume_file")"
  [[ "$last_resume" =~ ^[0-9]+$ ]] || return 1

  now="$(date +%s)"
  (( now - last_resume < ignore_resume_hotplug_seconds ))
}

steam_physical_controller_connected_since() {
  local since_epoch="$1"
  local connected_id=""
  local controller_id=""
  local line
  local message
  local pending_id=""
  local pending_wireless="0"
  local timestamp
  local timestamp_epoch
  declare -A connected=()

  [[ -r "$steam_controller_log" ]] || return 1

  while IFS= read -r line; do
    line="${line%$'\r'}"

    if ! [[ "$line" =~ ^\[([0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]][0-9]{2}:[0-9]{2}:[0-9]{2})\][[:space:]](.*)$ ]]; then
      if [[ -n "$pending_id" && "$pending_wireless" == "1" && "$line" =~ ^[[:space:]]*ProductID:[[:space:]]+4866$ ]]; then
        connected["$pending_id"]="1"
        pending_id=""
        pending_wireless="0"
      fi

      continue
    fi

    timestamp="${BASH_REMATCH[1]}"
    message="${BASH_REMATCH[2]}"
    timestamp_epoch="$(date -d "$timestamp" +%s 2>/dev/null || true)"
    [[ "$timestamp_epoch" =~ ^[0-9]+$ ]] || continue
    (( timestamp_epoch >= since_epoch )) || continue

    if [[ "$message" =~ ^Controller[[:space:]]+([0-9]+)[[:space:]]+connected ]]; then
      pending_id="${BASH_REMATCH[1]}"
      pending_wireless="0"
      continue
    fi

    if [[ "$message" =~ ^Controller[[:space:]]+([0-9]+)[[:space:]]+disconnected ]]; then
      controller_id="${BASH_REMATCH[1]}"
      connected["$controller_id"]="0"

      if [[ "$pending_id" == "$controller_id" ]]; then
        pending_id=""
        pending_wireless="0"
      fi

      continue
    fi

    if [[ -n "$pending_id" && "$message" == "!! Controller $pending_id attributes (wireless):" ]]; then
      pending_wireless="1"
      continue
    fi

    if [[ -n "$pending_id" && "$pending_wireless" == "1" && "$message" =~ ^[[:space:]]*ProductID:[[:space:]]+4866$ ]]; then
      connected["$pending_id"]="1"
      pending_id=""
      pending_wireless="0"
    fi
  done < <(tail -n "$steam_controller_log_lines" "$steam_controller_log")

  for connected_id in "${!connected[@]}"; do
    [[ "${connected[$connected_id]}" == "1" ]] && return 0
  done

  return 1
}

switch_if_steam_controller_connected_after_resume() {
  local resume_epoch="$1"

  sleep "$steam_resume_delay_seconds"

  if steam_physical_controller_connected_since "$resume_epoch"; then
    log "Steam physical controller connected after resume; switching to TV"
    switch_if_present "$resume_cec_wake_delay" 1 steam-resume
  else
    log "no Steam physical controller connection detected after resume"
  fi
}

watch_input_events() {
  local now

  udevadm monitor --udev --subsystem-match=input | while IFS= read -r line; do
    case "$line" in
      *add*|*bind*)
        now="$(date +%s)"
        if (( now - started_at < ignore_initial_hotplug_seconds )); then
          log "ignoring input hotplug during startup grace period"
          continue
        fi

        if resume_hotplug_suppressed; then
          log "ignoring input hotplug during resume grace period"
          continue
        fi

        sleep "$debounce_seconds"

        if input_hotplug_is_controller "$line"; then
          switch_if_present "" 0 input-hotplug
        fi
        ;;
    esac
  done
}

watch_resume_events() {
  dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" | while IFS= read -r line; do
    case "$line" in
      *"boolean true"*)
        date +%s >"$sleep_pending_file"
        ;;
      *"boolean false"*)
        date +%s >"$last_resume_file"
        rm -f "$sleep_pending_file"
        sync_steam_primary_display

        if [[ "$steam_resume_enable" == "1" ]]; then
          switch_if_steam_controller_connected_after_resume "$(<"$last_resume_file")"
        fi

        [[ "$switch_on_resume" == "1" ]] || continue

        sleep "$resume_delay_seconds"
        switch_if_present "$resume_cec_wake_delay" 1 resume
        ;;
    esac
  done
}

cleanup() {
  local pid

  for pid in "${child_pids[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
}

require_executable "$switch_to_tv_command"
require_command udevadm
require_command flock

if [[ "$switch_on_resume" == "1" || "$ignore_resume_hotplug_seconds" != "0" || "$steam_resume_enable" == "1" ]]; then
  require_command dbus-monitor
fi

if [[ "$switch_on_startup" == "1" ]]; then
  switch_if_present "" 0 startup
fi

if [[ "$switch_on_resume" == "1" ]]; then
  log "watching input hotplug and resume events"
elif [[ "$ignore_resume_hotplug_seconds" != "0" || "$steam_resume_enable" == "1" ]]; then
  log "watching input hotplug events with resume suppression"
else
  log "watching input hotplug events"
fi

trap cleanup EXIT INT TERM
watch_input_events & child_pids+=("$!")

if [[ "$switch_on_resume" == "1" || "$ignore_resume_hotplug_seconds" != "0" || "$steam_resume_enable" == "1" ]]; then
  watch_resume_events & child_pids+=("$!")
fi

wait -n "${child_pids[@]}"
