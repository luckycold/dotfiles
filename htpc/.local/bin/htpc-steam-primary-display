#!/usr/bin/env bash
set -euo pipefail

config_file="${SWITCH_TO_TV_CONFIG:-$HOME/.config/htpc-tv-switch/env}"
tv_output="${HTPC_STEAM_PRIMARY_TV_OUTPUT:-${SWITCH_TO_TV_OUTPUT:-DP-3}}"
fallback_output="${HTPC_STEAM_PRIMARY_FALLBACK_OUTPUT:-DP-1}"
cec_device="${HTPC_TV_CEC_DEVICE:-/dev/cec0}"
cec_timeout="${HTPC_TV_CEC_TIMEOUT:-5}"
cec_logical_address="${HTPC_TV_CEC_LOGICAL_ADDRESS:-4}"
cec_osd_name="${HTPC_TV_CEC_OSD_NAME:-HTPC}"
edid_path="${HTPC_TV_CEC_EDID:-}"

log() {
  printf 'htpc-steam-primary-display: %s\n' "$*"
}

die() {
  log "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

run_kscreen_doctor() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    QT_QPA_PLATFORM=wayland kscreen-doctor "$@"
  else
    kscreen-doctor "$@"
  fi
}

load_config() {
  if [[ -r "$config_file" ]]; then
    # shellcheck source=/dev/null
    source "$config_file"
  fi

  tv_output="${HTPC_STEAM_PRIMARY_TV_OUTPUT:-${SWITCH_TO_TV_OUTPUT:-$tv_output}}"
  fallback_output="${HTPC_STEAM_PRIMARY_FALLBACK_OUTPUT:-$fallback_output}"
  cec_device="${HTPC_TV_CEC_DEVICE:-$cec_device}"
  cec_timeout="${HTPC_TV_CEC_TIMEOUT:-$cec_timeout}"
  cec_logical_address="${HTPC_TV_CEC_LOGICAL_ADDRESS:-$cec_logical_address}"
  cec_osd_name="${HTPC_TV_CEC_OSD_NAME:-$cec_osd_name}"
  edid_path="${HTPC_TV_CEC_EDID:-$edid_path}"
}

edid_path_for_output() {
  local output="$1"
  local path

  for path in /sys/class/drm/*-"$output"/edid; do
    if [[ -r "$path" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done

  return 1
}

output_connected() {
  local output="$1"

  run_kscreen_doctor -j \
    | jq -e --arg output "$output" '.outputs[] | select(.name == $output and .connected == true)' \
    >/dev/null
}

tv_is_active_source() {
  local active_source_output
  local physical_address

  [[ -e "$cec_device" ]] || return 1

  if [[ -z "$edid_path" ]]; then
    edid_path="$(edid_path_for_output "$tv_output")" || return 1
  fi

  physical_address="$(edid-decode "$edid_path" 2>/dev/null | awk -F': ' '/Source physical address:/ { print $2; exit }')"
  [[ -n "$physical_address" ]] || return 1

  active_source_output="$(timeout "$cec_timeout" cec-ctl \
    --device "$cec_device" \
    --playback \
    --from "$cec_logical_address" \
    --osd-name "$cec_osd_name" \
    --phys-addr-from-edid "$edid_path" \
    --request-active-source \
    --monitor-time 2 \
    --monitor 2>&1 || true)"

  grep -q 'ACTIVE_SOURCE' <<<"$active_source_output" \
    && grep -q "phys-addr: $physical_address" <<<"$active_source_output"
}

set_primary_output() {
  local primary_output="$1"
  local secondary_output="$2"

  output_connected "$primary_output" || die "primary output is not connected: $primary_output"
  output_connected "$secondary_output" || die "secondary output is not connected: $secondary_output"

  run_kscreen_doctor \
    "output.$primary_output.priority.1" \
    "output.$secondary_output.priority.2" \
    >/dev/null
}

load_config

require_command cec-ctl
require_command edid-decode
require_command jq
require_command kscreen-doctor
require_command timeout

if tv_is_active_source; then
  log "TV input is active; making $tv_output primary for Steam"
  set_primary_output "$tv_output" "$fallback_output"
else
  log "TV input is not active; making $fallback_output primary for Steam"
  set_primary_output "$fallback_output" "$tv_output"
fi
